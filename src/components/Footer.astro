---
// Footer (Design, home page version 2, change 10): delivery area, ways to pay, Instagram. Legal pages in Help.
import Logo from './Logo.astro';
import company from '../data/company.json';
import strings from '../data/strings.json';
import features from '../data/features.json';
import WhatsAppButton from './WhatsAppButton.astro';
// Footer bottom padding is raised only when the WhatsApp button can show (see WhatsAppButton.astro).
const showWa = features.whatsappButton;
// The bottom bar is not shown on the basket page: it covered the form and opened the page already open (Design fix 6).
const onBasket = Astro.url.pathname.startsWith('/basket');
---
<footer id="contact" class={showWa ? 'has-wa' : undefined}><div class="ft"><div class="wrap ftg">
  <div class="col"><Logo size={44} word={26} dark />
    <span>Printed in small batches in Selangor, Malaysia.</span>
    {/* Design's footer lines approved by Viveg (26 Nov 2026); company name and number per Companies Act 2016 s.30 */}
    <span>Email <a href={`mailto:${company.email}`}>{company.email}</a> · WhatsApp (messages only): <a href={company.whatsappLink} target="_blank" rel="noopener">{company.whatsappLocal}</a></span>
    <span class="coline">© 2026 {company.registeredName} {company.registrationNumber}</span>
    <span>{company.town}</span>
  </div>
  <div class="col"><b class="fh">Shop</b><a href="/#sets">All sets</a><a href="/grand-kitchen-bundle/">Grand Kitchen Bundle</a><a href="/holders/">Holders</a><a href="/#schools">For schools</a></div>
  <div class="col"><b class="fh">About</b><a href="/#story">Our story</a><a href="/#made">How it's made</a><a href="/#faq">FAQ</a></div>
  <div class="col"><b class="fh">Help</b><a href="/delivery/">Delivery</a><a href="/returns/">Returns and refunds</a><a href="/terms/">Terms of sale</a><a href="/privacy/">Privacy notice</a></div>
  <div class="col fx"><span>{strings.deliveryArea.en}</span><span>Pay with cards, FPX, DuitNow QR, Touch 'n Go eWallet, GrabPay, ShopeePay or SPayLater.</span><span>Instagram: <a class="ig" href={company.instagram} rel="noopener">@attrahouse</a></span></div>
</div></div></footer>
{!onBasket && <div class="bbar"><a class="btn main" href="/#sets">Shop the sets</a><a class="btn line" href="/basket/">Basket <span data-basket-count></span></a></div>}
<WhatsAppButton />
<script is:inline src="/js/basket.js" defer></script>
