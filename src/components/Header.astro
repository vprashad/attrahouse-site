---
import Logo from './Logo.astro';
---
<header class="site"><div class="wrap hd">
  <Logo href="/" />
  <nav aria-label="Main" id="main-nav"><a href="/#sets">Shop</a><a href="/holders/">Holders</a><a href="/basket/">Basket <span data-basket-count></span></a></nav>
  <div class="row hd-actions">
    <a class="btn line basket-link" href="/basket/">Basket <span data-basket-count></span></a>
    <button class="btn line menu-btn" type="button" aria-expanded="false" aria-controls="main-nav">Menu</button>
  </div>
</div></header>
<script is:inline>
(function(){var b=document.querySelector('.menu-btn'),n=document.getElementById('main-nav');if(!b||!n)return;
function set(o){b.setAttribute('aria-expanded',o);n.classList.toggle('open',o);}
b.addEventListener('click',function(){set(b.getAttribute('aria-expanded')!=='true');});
document.addEventListener('keydown',function(e){if(e.key==='Escape'&&n.classList.contains('open')){set(false);b.focus();}});
n.addEventListener('click',function(e){if(e.target.closest('a'))set(false);});})();
</script>
