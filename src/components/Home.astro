---
import Header from './Header.astro';
import Footer from './Footer.astro';
import Art from './Art.astro';
import ProductCard from './ProductCard.astro';
import QuickAdd from './QuickAdd.astro';
import strings from '../data/strings.json';
import StockTag from './StockTag.astro';
import catalogue from '../data/products.json';
import { rm } from '../lib/site.js';
const products = catalogue.products.filter((p) => !p.group);
const bundle = products.find((p) => p.featured);
const rest = products.filter((p) => !p.featured);
const holders = catalogue.groups.holders;
const priceOf = (sku) => catalogue.products.find((p) => p.sku === sku)?.priceSen ?? 0;
// Worked out from the Bundle's contents, never typed (Design spec, 19 Nov 2026).
const separateSen = bundle ? bundle.contains.reduce((t, s) => t + priceOf(s), 0) : 0;
---
<Header />
<main>
  <section class="snap" id="snap" aria-label="Magnetic watermelon"><div class="stage"><div class="wrap sg">
    <div class="words">
      <h1>Play food that snaps apart and back again</h1>
      <p class="lead">Life-size fruit and vegetables that pull apart along hidden magnets. Made in small batches in Malaysia, for ages 3 and up.</p>
      <div class="row"><a class="btn main" href="#sets">Shop the sets</a></div>
      <ul class="clicks" id="snap-marks">
        <li class="mk" style="--c:var(--red)">Magnets, not velcro</li>
        <li class="mk" style="--c:var(--orange)">Life-size pieces</li>
        <li class="mk" style="--c:var(--green)">Colour printed in, nothing to peel</li>
      </ul>
    </div>
    <div class="fw"><Art name="watermelon" /><span class="standin">Stand-in drawing</span></div>
  </div><div class="cue" id="snap-cue" aria-hidden="true">Scroll ↓</div></div></section>

  <section class="band" id="sets"><div class="wrap sec">
    <h2>Four sets, or all of them in one box</h2>
    {bundle && (
      <div class="bundle">
        <div class="tile big" style="--t:var(--ink)"><span>Photo: the whole bundle laid out, box open</span></div>
        <div class="col">
          <h3 class="lbl">The gift pick</h3><b class="h1">{bundle.name}</b><p>{bundle.note}.</p>
          <div class="row"><span class="pr big">{rm(bundle.priceSen)}</span><span class="tag">Save {rm(separateSen - bundle.priceSen)}</span><StockTag sku={bundle.sku} /></div>
          <p class="sm">{rm(separateSen)} if you buy the four separately.</p>
          <p class="sm">{strings.bundlePerk}</p>
          <QuickAdd sku={bundle.sku} name={bundle.name} href={`/${bundle.sku}/`} />
          <div class="row"><a class="link" href={`/${bundle.sku}/`}>See what's in the Bundle</a></div>
        </div>
      </div>
    )}
    <div class="grid cards">{rest.map((p) => <ProductCard p={p} />)}</div>
    <div class="grid cards">
      <div class="card">
        <a class="card-link" href="/holders/">
          <div class="tile" style="--t:var(--yellow)"><span>Photo goes here</span></div>
          <b>{holders.name}</b>
        </a>
        <span class="pr">Any 2 for {rm(holders.pairPriceSen)}</span>
        <span><StockTag sku="pouch-holder" /> <StockTag sku="juicebox-holder" /></span>
        <QuickAdd holders name={holders.name} href="/holders/" />
      </div>
    </div>
  </div></section>

  <section><div class="wrap sec two">
    <div class="col"><h2>What parents should know before play starts</h2>
      <div class="row"><span class="tag">Ages 3+</span></div>
      <p>The sets are for children aged 3 and up.</p>
      <p class="sm">[Plain summary of how the magnets are fixed and what parents should check, from Compliance and R&amp;D]</p></div>
    <div class="msg safe"><div class="row"><span class="tag warn">Warning</span></div><b>[Magnet warning wording, from Compliance]</b><span>[Material and testing statements, each with its evidence, from Compliance and R&amp;D]</span></div>
  </div></section>
</main>
<Footer />
<script is:inline src="/js/snap.js" defer></script>
<script is:inline src="/js/stock.js" defer></script>
<script is:inline src="/js/quickadd.js" defer></script>
<div class="toast" id="qa-toast" role="status" aria-live="polite" hidden><span data-toast-msg></span> · <a class="link" href="/basket/">{strings.viewBasket.en}</a></div>
