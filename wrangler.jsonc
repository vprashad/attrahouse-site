{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "attrahouse-site",
  "main": "src/worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Viveg creates the database in Cloudflare (Storage & databases > D1 > Create, name "attrahouse-stock")
  // and sends Claude its ID to paste here. The ID is not a secret.
  "d1_databases": [
    { "binding": "DB", "database_name": "attrahouse-stock", "database_id": "014a8adf-ff78-4f85-a077-8b94c037d122", "migrations_dir": "migrations" }
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": { "CHECKOUT_ENABLED": "false" },
  // Settings for preview links (any branch except main). Before launch, previews share the
  // stock database on purpose. LAUNCH CHECKLIST: give previews their own database before
  // the first real sale, so tests on a preview can never change real stock.
  "previews": {
    "vars": { "CHECKOUT_ENABLED": "false" },
    "d1_databases": [
      { "binding": "DB", "database_name": "attrahouse-stock", "database_id": "014a8adf-ff78-4f85-a077-8b94c037d122" }
    ]
  },
  // .sql files are bundled as text so the Worker can create its own tables.
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }]
}
