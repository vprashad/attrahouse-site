{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "attrahouse-site",
  "main": "src/worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/admin", "/admin/*"]
  },
  // Viveg creates the database in Cloudflare (Storage & databases > D1 > Create, name "attrahouse-stock")
  // and sends Claude its ID to paste here. The ID is not a secret.
  "d1_databases": [
    { "binding": "DB", "database_name": "attrahouse-stock", "database_id": "014a8adf-ff78-4f85-a077-8b94c037d122", "migrations_dir": "migrations" }
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  // Keep Worker logs so errors such as a HitPay amount mismatch can be read in Observability.
  "observability": { "enabled": true },
  // Live site: no buying until launch. HITPAY_BASE switches to https://api.hit-pay.com at launch.
  // Cloudflare Access for /admin (app "Attra House admin", 18 Nov 2026). Team domain and audience tag
  // are identifiers, not secrets; kept here so a deploy never wipes them.
  "vars": { "CHECKOUT_ENABLED": "false", "LIVE_PAYMENTS": "false", "CURRENCY": "MYR", "STOCK_DB": "attrahouse-stock", "ACCESS_TEAM_DOMAIN": "attrahouse.cloudflareaccess.com", "ACCESS_AUD": "0d1bc0a82e1d1d31e8fd53c7f3ccc7dc9f54f308433119e2a70f5703744d68fd" },
  // Settings for preview links (any branch except main). Previews use their own test database
  // (attrahouse-stock-preview, created by Viveg 18 Nov 2026), so tests never change real stock.
  // STOCK_DB names the database for the "Settings in use" box on /admin; change it together
  // with the binding below.
  "previews": {
    // Previews take test payments through the HitPay sandbox. HITPAY_API_KEY_SANDBOX and
    // HITPAY_WEBHOOK_SALT_SANDBOX are secrets Viveg adds in Cloudflare; they are never in this file.
    "vars": { "CHECKOUT_ENABLED": "true", "LIVE_PAYMENTS": "false", "CURRENCY": "MYR", "HITPAY_BASE": "https://api.sandbox.hit-pay.com", "STOCK_DB": "attrahouse-stock-preview", "ACCESS_TEAM_DOMAIN": "attrahouse.cloudflareaccess.com", "ACCESS_AUD": "0d1bc0a82e1d1d31e8fd53c7f3ccc7dc9f54f308433119e2a70f5703744d68fd" },
    "d1_databases": [
      { "binding": "DB", "database_name": "attrahouse-stock-preview", "database_id": "cbb96cf0-5faa-4f2f-ac65-163ecefaa03d" }
    ]
  },
  // .sql files are bundled as text so the Worker can create its own tables.
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }]
}
