{
  "name": "attrahouse-site",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/prune-landing.mjs",
    "build:shop": "SITE_MODE=shop npm run build",
    "check:content": "node scripts/check-placeholders.mjs",
    "test": "node --test test/*.test.js",
    "preview": "wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/fredoka": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "astro": "7.4.4"
  },
  "devDependencies": {
    "wrangler": "4.156.1"
  },
  "engines": { "node": ">=22.5" }
}
